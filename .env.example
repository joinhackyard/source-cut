# Copy to .env and fill in. Every tool in Source Cut reads its settings from here (or from your shell).
# Never commit .env.

# Render VM (Docker host that runs the hyperframes-runner image)
SOURCE_CUT_RENDER_HOST=user@your-render-vm        # ssh target
SOURCE_CUT_SSH_KEY=~/.ssh/id_ed25519               # key for that host
SOURCE_CUT_REMOTE_ROOT=/home/user/videos           # where projects are synced on the VM

# Azure AI Speech (narration + word timings)
SPEECH_KEY=
SPEECH_REGION=centralindia
SPEECH_VOICE=en-US-Andrew:DragonHDLatestNeural

# Azure OpenAI image model (thumbnails)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_KEY=
AZURE_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst

# Polite User-Agent for Wikimedia Commons and other archives
SOURCE_CUT_USER_AGENT=SourceCut/1.0 (https://github.com/joinhackyard/source-cut)
